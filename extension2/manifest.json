{
  "manifest_version": 3,
  "name": "VK Tracklist Export",
  "version": "1.0.0",
  "description": "Exports VK playlist track lists for the Revseeker web app.",

  "permissions": ["scripting", "tabs", "downloads", "alarms"],
  "host_permissions": [
    "https://vk.com/*",
    "https://vk.ru/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VK Tracklist Export"
  }
}